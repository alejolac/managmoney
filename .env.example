# Copiar a .env y completar. El .env real NO se commitea.

# --- Base de datos ---------------------------------------------------------
# Postgres. En Neon copiala desde el dashboard del proyecto (usa la pooled).
DATABASE_URL="postgresql://user:password@host/managoney?sslmode=require"

# --- Seguridad -------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar el secreto TOTP en la base.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Deja crear el primer usuario. Apagalo (false) apenas termines de
# registrarte: la app es de un solo usuario y el alta publica queda cerrada.
ALLOW_REGISTRATION="true"

# --- Claude (fase 4) -------------------------------------------------------
# Solo se usa desde el servidor. Nunca se expone al navegador.
ANTHROPIC_API_KEY=""
