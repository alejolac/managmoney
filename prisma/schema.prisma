// Managoney - modelo de datos
//
// Decisiones que atraviesan todo el schema:
//
// 1. Los montos son siempre POSITIVOS. El signo lo da `Transaction.type`.
//    Evita el bug clasico de sumar signos mal en los reportes.
//
// 2. Todo monto es Decimal(18,4). Nunca Float: los floats pierden centavos.
//
// 3. Cada transaccion guarda su moneda original + la conversion a la moneda
//    base del workspace CONGELADA al momento (`amountBase` + `baseRate`).
//    Asi un reporte de marzo no cambia porque hoy se movio el dolar.
//
// 4. Una transferencia es UNA fila con los dos lados (`amount` sale de
//    `account`, `toAmount` entra a `toAccount`). Cuando cambias UYU a USD
//    cargas los dos montos reales y la cotizacion efectiva de Itau sale sola.
//
// 5. Todo cuelga de `Workspace`, no de `User`. Hoy hay un solo usuario, pero
//    compartir con otra persona despues es agregar un Membership, no migrar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  /// `relationJoins` habilita `relationLoadStrategy: "join"`. Sin esto, cada
  /// `include` es una consulta aparte: traer 50 movimientos con su cuenta y su
  /// categoria son 3 idas y vueltas a Ohio (~450 ms) en vez de una (~150 ms).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Currency {
  UYU
  USD
  EUR
  BRL
  ARS
}

enum AccountType {
  CASH // efectivo
  CHECKING // cuenta corriente / donde cae el sueldo
  SAVINGS // caja de ahorro
  CREDIT_CARD // tarjeta de credito
  DIGITAL_WALLET // Mercado Pago, Prex, Midinero
  INVESTMENT // reservado, fuera de alcance por ahora
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TxType {
  EXPENSE
  INCOME
  TRANSFER
}

/// De donde salio la transaccion. Sirve para deduplicar imports y para
/// saber que se cargo a mano y que vino de OCR o del banco.
enum TxSource {
  MANUAL
  RECURRING
  INSTALLMENT
  IMPORT
  OCR
  BANK_API
}

enum EnvelopeKind {
  MONTHLY // se asigna cada mes, ej "Salidas"
  GOAL // acumulativo, ej "Viaje USD 3000"
}

enum RolloverMode {
  RESET // lo que no gastaste no pasa al mes siguiente (default)
  CARRY_OVER // el sobrante se suma al mes que viene
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum RecurrenceMode {
  AUTO // se crea sola en la fecha
  CONFIRM // te avisa y confirmas vos (default)
}

/// Clasifica los compromisos para la pantalla que los junta a todos.
enum CommitmentKind {
  SUBSCRIPTION // Netflix, Spotify, gimnasio
  FIXED_EXPENSE // alquiler, seguro, cuota de salud
  INCOME // sueldo
}

enum MemberRole {
  OWNER
  MEMBER
}

enum DebtDirection {
  THEY_OWE_ME
  I_OWE_THEM
}

enum DebtStatus {
  OPEN
  SETTLED
}

enum OcrStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ============================================================
// IDENTIDAD Y SEGURIDAD
// ============================================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String // Argon2id

  /// Secreto TOTP cifrado en reposo (AES-256-GCM con APP_ENCRYPTION_KEY).
  /// Nunca se guarda en claro.
  totpSecret    String?
  totpEnabledAt DateTime?

  /// Bloqueo temporal ante intentos fallidos de login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  recoveryCodes RecoveryCode[]
  memberships   Membership[]

  @@index([email])
}

model Session {
  id     String @id @default(cuid())
  userId String

  /// SHA-256 del token. El token en claro vive solo en la cookie httpOnly,
  /// asi un dump de la base no permite robar sesiones.
  tokenHash String @unique

  /// La sesion existe pero todavia no paso el segundo factor.
  /// Sin esto, validar la password ya te dejaria entrar.
  pending2fa Boolean @default(false)

  userAgent String?
  ip        String?

  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Codigos de un solo uso para recuperar la cuenta si perdes el celular.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  baseCurrency Currency @default(UYU)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          Membership[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurrences      Recurrence[]
  envelopes        Envelope[]
  budgets          Budget[]
  tags             Tag[]
  receipts         Receipt[]
  categoryRules    CategoryRule[]
  debts            Debt[]
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String
  role        MemberRole @default(OWNER)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ============================================================
// CUENTAS
// ============================================================

model Account {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        AccountType

  /// Una cuenta tiene UNA moneda. Tu caja de ahorro en USD y la de UYU
  /// son dos cuentas distintas, y pasar plata de una a otra es una
  /// transferencia con cotizacion real.
  currency    Currency
  institution String? // "Itau", "BROU", "Prex", "Mercado Pago"

  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  openingDate    DateTime @default(now())

  /// Solo tarjetas de credito.
  creditLimit         Decimal? @db.Decimal(18, 4)
  statementClosingDay Int? // dia de cierre, 1-31
  paymentDueDay       Int? // dia de vencimiento, 1-31

  /// Marca las cuentas que son ahorro (tipicamente la de dolares).
  /// Sacar plata de aca es "desahorro" y el dashboard lo muestra aparte:
  /// es la senal de que el mes no cerro.
  isSavings Boolean @default(false)

  color      String    @default("#64748b")
  icon       String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?

  /// Reservado para una integracion bancaria futura (Prometeo, etc).
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]     @relation("TxAccount")
  incomingTransfers Transaction[]     @relation("TxToAccount")
  installmentPlans  InstallmentPlan[]
  recurrences       Recurrence[]
  envelopes         Envelope[]
  categoryRules     CategoryRule[]

  @@index([workspaceId])
}

// ============================================================
// CATEGORIAS
// ============================================================

/// Catalogo CERRADO. Nada crea categorias solo: ni el OCR, ni el import,
/// ni las reglas. Si algo no matchea, cae en la categoria de sistema
/// "Sin categorizar" y la asignas vos despues.
model Category {
  id          String       @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  kind        CategoryKind

  color     String  @default("#64748b")
  icon      String?
  sortOrder Int     @default(0)

  /// Las de sistema ("Sin categorizar", "Transferencia") no se borran.
  isSystem   Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurrences      Recurrence[]
  budgets          Budget[]
  categoryRules    CategoryRule[]

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId, kind])
}

// ============================================================
// TRANSACCIONES
// ============================================================

model Transaction {
  id          String @id @default(cuid())
  workspaceId String

  type TxType

  /// Cuando ocurrio la operacion (la fecha de la compra).
  date DateTime

  /// Cuando impacta la caja de verdad. En tarjeta de credito es la fecha
  /// de vencimiento del resumen, que puede ser dos meses despues.
  /// Para todo lo demas es igual a `date`.
  settlementDate DateTime

  /// Cuenta de origen en gastos y transferencias, de destino en ingresos.
  accountId String

  /// Siempre positivo, en la moneda de `account`.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  /// Solo transferencias. Cargas los dos montos reales y la cotizacion
  /// efectiva se deriva: no se estima nada.
  toAccountId String?
  toAmount    Decimal?  @db.Decimal(18, 4)
  toCurrency  Currency?

  /// Conversion a la moneda base del workspace, congelada al momento.
  amountBase Decimal @db.Decimal(18, 4)
  baseRate   Decimal @db.Decimal(18, 8)

  categoryId  String?
  description String?
  merchant    String?
  notes       String?

  /// Cuota N de M de un plan.
  installmentPlanId String?
  installmentNumber Int?

  recurrenceId String?
  envelopeId   String?
  debtId       String?

  source TxSource @default(MANUAL)

  /// Id en el sistema de origen (banco / import). Evita duplicados.
  externalId String?

  /// Transferencia que saca plata de una cuenta de ahorro.
  isDissaving Boolean @default(false)

  /// Para dejar afuera de estadisticas cosas puntuales sin borrarlas.
  excludeFromStats Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account            @relation("TxAccount", fields: [accountId], references: [id])
  toAccount       Account?           @relation("TxToAccount", fields: [toAccountId], references: [id])
  category        Category?          @relation(fields: [categoryId], references: [id])
  installmentPlan InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  recurrence      Recurrence?        @relation(fields: [recurrenceId], references: [id])
  envelope        Envelope?          @relation(fields: [envelopeId], references: [id])
  debt            Debt?              @relation(fields: [debtId], references: [id])
  tags            TagOnTransaction[]
  receipts        Receipt[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, date])
  @@index([workspaceId, settlementDate])
  @@index([workspaceId, categoryId, date])
  @@index([workspaceId, accountId, date])
  @@index([installmentPlanId])
}

/// Una compra en cuotas: UN gasto, N impactos de caja.
/// El plan guarda la compra; las N transacciones vinculadas son los pagos.
model InstallmentPlan {
  id          String  @id @default(cuid())
  workspaceId String
  accountId   String // la tarjeta
  categoryId  String?

  description String
  merchant    String?

  totalAmount Decimal  @db.Decimal(18, 4)
  currency    Currency
  count       Int // cantidad de cuotas

  purchaseDate DateTime
  firstDueDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([workspaceId])
}

/// Gastos e ingresos que se repiten. Cubre tanto el alquiler como Netflix:
/// `kind` los separa para la pantalla de compromisos.
model Recurrence {
  id          String         @id @default(cuid())
  workspaceId String
  kind        CommitmentKind @default(FIXED_EXPENSE)
  type        TxType
  accountId   String
  categoryId  String?

  description String
  merchant    String?
  amount      Decimal  @db.Decimal(18, 4)
  currency    Currency

  frequency  Frequency @default(MONTHLY)
  interval   Int       @default(1)
  dayOfMonth Int?
  weekday    Int?

  startDate   DateTime
  endDate     DateTime?
  nextRunDate DateTime

  mode RecurrenceMode @default(CONFIRM)

  pausedAt   DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([workspaceId, nextRunDate])
}

// ============================================================
// SOBRES Y PRESUPUESTOS
// ============================================================

/// Un sobre es plata REALMENTE reservada: sale de tu disponible.
/// Distinto de Budget, que es solo un limite que te avisa.
///   - MONTHLY: "Salidas $5000", se reasigna cada mes.
///   - GOAL:    "Viaje USD 3000", se acumula hasta la meta.
model Envelope {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  kind        EnvelopeKind @default(MONTHLY)
  currency    Currency

  /// Solo MONTHLY: cuanto asignas por defecto cada mes.
  monthlyAmount Decimal?     @db.Decimal(18, 4)
  rollover      RolloverMode @default(RESET)

  /// Solo GOAL.
  targetAmount Decimal?  @db.Decimal(18, 4)
  targetDate   DateTime?
  accountId    String? // donde se acumula la plata

  color      String    @default("#64748b")
  icon       String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account?         @relation(fields: [accountId], references: [id])
  periods      EnvelopePeriod[]
  transactions Transaction[]

  @@index([workspaceId])
}

/// Lo asignado a un sobre en un mes concreto. Existe como tabla aparte para
/// poder cambiar la asignacion de un mes sin tocar el historial de los otros.
model EnvelopePeriod {
  id         String @id @default(cuid())
  envelopeId String
  year       Int
  month      Int // 1-12

  allocated Decimal @db.Decimal(18, 4)

  /// Sobrante arrastrado del mes anterior (0 si rollover = RESET).
  carriedIn Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, year, month])
}

/// Limite de gasto por categoria. No reserva plata, solo avisa.
/// year/month en null = presupuesto por defecto para todos los meses.
model Budget {
  id          String   @id @default(cuid())
  workspaceId String
  categoryId  String
  amount      Decimal  @db.Decimal(18, 4)
  currency    Currency
  year        Int?
  month       Int?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId, year, month])
}

// ============================================================
// COTIZACIONES
// ============================================================

/// Cotizacion de REFERENCIA (BCU), usada solo para mostrar reportes
/// historicos en otra moneda. La cotizacion de una operacion real de cambio
/// no sale de aca: se deriva de los dos montos de la transferencia.
model ExchangeRate {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  from   Currency
  to     Currency
  rate   Decimal  @db.Decimal(18, 8)
  source String   @default("BCU")

  createdAt DateTime @default(now())

  @@unique([date, from, to])
  @@index([from, to, date])
}

// ============================================================
// TAGS, COMPROBANTES Y REGLAS
// ============================================================

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#64748b")

  createdAt DateTime @default(now())

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions TagOnTransaction[]

  @@unique([workspaceId, name])
}

model TagOnTransaction {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model Receipt {
  id            String  @id @default(cuid())
  workspaceId   String
  transactionId String?

  storageKey String // key en el blob storage, no la imagen en la base
  mimeType   String
  sizeBytes  Int

  ocrStatus OcrStatus @default(PENDING)
  /// Salida cruda del modelo, para poder auditar que leyo mal.
  ocrResult Json?
  ocrError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, ocrStatus])
}

/// Auto-categorizacion. Solo APUNTA a categorias existentes, nunca crea.
model CategoryRule {
  id          String  @id @default(cuid())
  workspaceId String
  categoryId  String
  accountId   String? // limitar la regla a una cuenta

  pattern String
  isRegex Boolean @default(false)

  /// Mayor prioridad gana cuando varias reglas matchean.
  priority Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, priority])
}

// ============================================================
// DEUDAS Y GASTOS COMPARTIDOS
// ============================================================

/// Plata que te deben o que debes. Tambien cubre el split: pagaste una cena
/// de 4 y quedan 3 deudas OPEN apuntando a esa transaccion.
model Debt {
  id           String        @id @default(cuid())
  workspaceId  String
  counterparty String
  direction    DebtDirection
  amount       Decimal       @db.Decimal(18, 4)
  currency     Currency
  description  String?
  dueDate      DateTime?

  status    DebtStatus @default(OPEN)
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, status])
}
